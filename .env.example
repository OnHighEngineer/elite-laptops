# Copy to .env.local and fill in. Never commit .env.local. Full guide: docs/SETUP.md
# Only variables starting with NEXT_PUBLIC_ reach the browser. Everything else stays on the server.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used in email links), e.g. https://www.elitelaptops.in
# REQUIRED in production: emails refuse to build links without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay TEST keys (Dashboard -> Account & Settings -> API Keys, Test Mode).
# Swap these for Live keys to go live. The secret stays server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase service role (Project Settings -> API). SERVER ONLY, never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay webhook secret (Dashboard -> Webhooks -> your endpoint)
RAZORPAY_WEBHOOK_SECRET=

# Order emails via Resend (free tier). EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
STORE_NOTIFY_EMAIL=

# Random string (32+ chars) used to sign newsletter confirm/unsubscribe links. `openssl rand -hex 32`
NEWSLETTER_SECRET=

# The ONE admin account email. Server-only; never shown in the browser. Only this login can open /admin.
ADMIN_EMAIL=

# Random string (32+ chars). Vercel Cron sends it to free abandoned checkout holds. `openssl rand -hex 32`
CRON_SECRET=

# Cloudinary (photos). Dashboard -> Settings -> API Keys. The API secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder name for uploaded photos
CLOUDINARY_FOLDER=elite_laptops_products
